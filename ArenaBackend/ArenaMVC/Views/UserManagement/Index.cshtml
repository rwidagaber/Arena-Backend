@model ArenaMVC.Models.UserListPagedViewModel

@{
    ViewData["Title"] = Localizer["UsersManagement"];
}

<link rel="stylesheet" href="~/css/subscription-admin.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/booking-admin.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/user-admin.css" asp-append-version="true" />

<div class="subscription-admin-container">
    <div class="subscription-admin-header d-flex flex-wrap align-items-start justify-content-between gap-3">
        <div>
            <h1><i data-lucide="users" style="width: 32px; height: 32px; vertical-align: middle; margin-inline-end: 8px;"></i>@Localizer["UsersManagement"]</h1>
            <p>@Localizer["ManageUserStatus"]</p>
        </div>
    </div>

    <div class="mt-4">
        @if (TempData["Success"] != null)
        {
            <div class="subscription-alert success">
                <strong>@Localizer["Success"]</strong> @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="subscription-alert error">
                <strong>@Localizer["Error"]</strong> @TempData["Error"]
            </div>
        }

        <!-- Search & Filter Card -->
        <div class="booking-filters-card mb-4">
            <form id="userFiltersForm" method="get" class="row g-3 align-items-end">
                <input type="hidden" name="page" value="1" />
                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                
                <!-- Search Input -->
                <div class="col-12 col-lg-6">
                    <label class="form-label" for="searchInput">@Localizer["Search"]</label>
                    <div class="search-input-wrapper" id="searchWrapper" style="position: relative;">
                        <span style="position: absolute; inset-inline-start: 16px; top: 50%; transform: translateY(-50%); color: var(--autonomous); display: flex; align-items: center; z-index: 10; pointer-events: none;">
                            <i data-lucide="search" style="width: 18px; height: 18px;"></i>
                        </span>
                        <input class="form-control" id="searchInput" type="text" name="search"
                               value="@Model.Search"
                               placeholder="@Localizer["SearchByNameOrEmail"]"
                               autocomplete="off" style="padding-inline-start: 46px;" />
                        <!-- Loading spinner shown during AJAX fetch -->
                        <span id="searchSpinner" style="display:none; position: absolute; inset-inline-end: 16px; top: 50%; transform: translateY(-50%); color: var(--autonomous);">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="animation: spin 0.8s linear infinite;">
                                <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
                            </svg>
                        </span>
                    </div>
                </div>

                <!-- Account Status Dropdown -->
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <label class="form-label" for="accountStatusSelect">@Localizer["AccountStatus"]</label>
                    <select class="form-select filter-select" id="accountStatusSelect" name="isActive">
                        <option value="" selected="@(Model.IsActive is null ? "selected" : null)">@Localizer["All"]</option>
                        <option value="true" selected="@(Model.IsActive == true ? "selected" : null)">@Localizer["Active"]</option>
                        <option value="false" selected="@(Model.IsActive == false ? "selected" : null)">@Localizer["Inactive"]</option>
                    </select>
                </div>

                <!-- Member Type Dropdown -->
                @* <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <label class="form-label" for="memberStatusSelect">@Localizer["Member"]</label>
                    <select class="form-select filter-select" id="memberStatusSelect" name="membershipStatus">
                        <option value="" selected="@(Model.MembershipStatusFilter is null ? "selected" : null)">@Localizer["All"]</option>
                        <option value="User" selected="@(Model.MembershipStatusFilter == ArenaDomain.Enums.MembershipStatus.User ? "selected" : null)">@Localizer["User"]</option>
                        <option value="ActiveMembership" selected="@(Model.MembershipStatusFilter == ArenaDomain.Enums.MembershipStatus.ActiveMembership ? "selected" : null)">@Localizer["ActiveMembership"]</option>
                        <option value="ExpiredMembership" selected="@(Model.MembershipStatusFilter == ArenaDomain.Enums.MembershipStatus.ExpiredMembership ? "selected" : null)">@Localizer["ExpiredMembership"]</option>
                    </select>
                </div> *@

                <!-- Subscription Status Dropdown -->
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <label class="form-label" for="subscriptionStatusSelect">@Localizer["SubscriptionStatus"]</label>
                    <select class="form-select filter-select" id="subscriptionStatusSelect" name="subscriptionStatus">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.SubscriptionStatusFilter) ? "selected" : null)">@Localizer["All"]</option>
                        <option value="NoSubscription" selected="@(Model.SubscriptionStatusFilter == "NoSubscription" ? "selected" : null)">@Localizer["NoSubscription"]</option>
                        <option value="Active" selected="@(Model.SubscriptionStatusFilter == "Active" ? "selected" : null)">@Localizer["Active"]</option>
                        <option value="Expired" selected="@(Model.SubscriptionStatusFilter == "Expired" ? "selected" : null)">@Localizer["Expired"]</option>
                    </select>
                </div>
            </form>
        </div>

        <!-- Live-search results container – updated via AJAX -->
        <div id="userResultsContainer">
            @await Html.PartialAsync("_UserResults", Model)
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade modal-dark" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title d-inline-flex align-items-center gap-2" id="deleteConfirmModalLabel">
                    <i data-lucide="alert-triangle" style="width: 20px; height: 20px; color: #ef4444;"></i> @Localizer["ConfirmDeletion"]
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @Localizer["AreYouSureDeleteUser"]
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post" style="margin: 0;">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="submit" class="btn btn-subscription-danger" style="height: 38px;">@Localizer["Confirm"]</button>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <style>
        @@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
        
        .booking-filters-card .search-input-wrapper input.form-control {
            padding-inline-start: 3rem !important;
            padding-top: 0 !important;
            padding-bottom: 0 !important;
            height: 46px !important;
            font-size: 0.95rem !important;
        }
        .booking-filters-card select.form-select {
            height: 46px !important;
            padding-top: 0 !important;
            padding-bottom: 0 !important;
        }
    </style>
    <script>
        (function () {
            /* ── helpers ────────────────────────────────────────────────── */
            function debounce(fn, delay) {
                var timer;
                return function () {
                    clearTimeout(timer);
                    timer = setTimeout(fn, delay);
                };
            }

            function reinitLucide() {
                if (window.lucide && typeof lucide.createIcons === 'function') {
                    lucide.createIcons();
                }
            }

            /* ── state ──────────────────────────────────────────────────── */
            var currentSearch = @Html.Raw(Json.Serialize(Model.Search ?? ""));
            var pageSize      = @Model.PageSize;
            var searchUrl     = '@Url.Action("SearchPartial", "UserManagement")';
            var activeRequest = null;

            /* ── core fetch ─────────────────────────────────────────────── */
            function fetchResults(search, page) {
                page = page || 1;

                var spinner = document.getElementById('searchSpinner');
                if (spinner) spinner.style.display = 'inline-flex';

                var isActiveVal = document.getElementById('accountStatusSelect')?.value || '';
                var membershipStatusVal = document.getElementById('memberStatusSelect')?.value || '';
                var subscriptionStatusVal = document.getElementById('subscriptionStatusSelect')?.value || '';

                // Build query string
                var params = new URLSearchParams({ 
                    search: search || '', 
                    isActive: isActiveVal,
                    membershipStatus: membershipStatusVal,
                    subscriptionStatus: subscriptionStatusVal,
                    page: page, 
                    pageSize: pageSize 
                });
                var url    = searchUrl + '?' + params.toString();

                // Abort previous in-flight request if any
                if (activeRequest) { activeRequest.abort(); }
                var controller = new AbortController();
                activeRequest  = controller;

                fetch(url, { signal: controller.signal, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (res) { return res.text(); })
                    .then(function (html) {
                        var container = document.getElementById('userResultsContainer');
                        if (container) {
                            container.innerHTML = html;
                            reinitLucide();
                            bindDeleteModal();
                            bindPaginationLinks();
                        }
                    })
                    .catch(function (err) {
                        if (err.name !== 'AbortError') {
                            console.warn('Live search error:', err);
                        }
                    })
                    .finally(function () {
                        if (spinner) spinner.style.display = 'none';
                        activeRequest = null;
                    });
            }

            function updateUrlAndFetch(page) {
                var searchVal = document.getElementById('searchInput')?.value.trim() || '';
                var isActiveVal = document.getElementById('accountStatusSelect')?.value || '';
                var membershipStatusVal = document.getElementById('memberStatusSelect')?.value || '';
                var subscriptionStatusVal = document.getElementById('subscriptionStatusSelect')?.value || '';

                currentSearch = searchVal;

                // Keep browser URL in sync (no page reload)
                var stateParams = new URLSearchParams();
                if (searchVal) stateParams.set('search', searchVal);
                if (isActiveVal) stateParams.set('isActive', isActiveVal);
                if (membershipStatusVal) stateParams.set('membershipStatus', membershipStatusVal);
                if (subscriptionStatusVal) stateParams.set('subscriptionStatus', subscriptionStatusVal);
                stateParams.set('page', page.toString());

                history.replaceState(null, '', window.location.pathname + '?' + stateParams.toString());

                fetchResults(searchVal, page);
            }

            /* ── debounced input handler ─────────────────────────────────── */
            var debouncedFetch = debounce(function () {
                var input = document.getElementById('searchInput');
                if (!input) return;
                var val = input.value.trim();
                if (val === currentSearch) return;   // no change – skip
                updateUrlAndFetch(1);
            }, 350);

            /* ── pagination link intercept ──────────────────────────────── */
            function bindPaginationLinks() {
                var container = document.getElementById('userResultsContainer');
                if (!container) return;
                container.querySelectorAll('.usub-pagination a.usub-page-btn').forEach(function (link) {
                    link.addEventListener('click', function (e) {
                        e.preventDefault();
                        var href   = link.getAttribute('href') || '';
                        var urlObj = new URL(href, window.location.origin);
                        var page   = urlObj.searchParams.get('page') || '1';
                        updateUrlAndFetch(parseInt(page, 10));
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    });
                });
            }

            /* ── delete modal wiring ────────────────────────────────────── */
            function bindDeleteModal() {
                var modal = document.getElementById('deleteConfirmModal');
                if (!modal) return;
                // remove old listener to avoid duplicates then re-add
                var clone = modal.cloneNode(true);
                modal.parentNode.replaceChild(clone, modal);
                clone.addEventListener('show.bs.modal', function (event) {
                    var button = event.relatedTarget;
                    if (!button) return;
                    var userId = button.getAttribute('data-userid');
                    var form   = document.getElementById('deleteForm');
                    if (form) form.action = '@Url.Action("Delete", "UserManagement")/' + userId;
                });
            }

            /* ── autofocus cursor-to-end ────────────────────────────────── */
            function initInput() {
                var input = document.getElementById('searchInput');
                if (!input) return;

                if (input.value) {
                    input.focus();
                    var v = input.value;
                    input.value = '';
                    input.value = v;
                }

                input.addEventListener('input', debouncedFetch);

                // Bind dropdowns changes
                const selectFilters = ['accountStatusSelect', 'memberStatusSelect', 'subscriptionStatusSelect'];
                selectFilters.forEach(function (id) {
                    var el = document.getElementById(id);
                    if (el) {
                        el.addEventListener('change', function () {
                            updateUrlAndFetch(1);
                        });
                    }
                });
            }

            /* ── bootstrap ──────────────────────────────────────────────── */
            document.addEventListener('DOMContentLoaded', function () {
                initInput();
                bindDeleteModal();
                bindPaginationLinks();
            });
        })();
    </script>
}
