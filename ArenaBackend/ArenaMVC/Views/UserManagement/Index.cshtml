@model List<ArenaMVC.Models.UserListViewModel>

@{
    ViewData["Title"] = Localizer["UsersManagement"];
}

<link rel="stylesheet" href="~/css/subscription-admin.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/user-admin.css" asp-append-version="true" />

<div class="subscription-admin-container">
    <div class="subscription-admin-header d-flex flex-wrap align-items-start justify-content-between gap-3">
        <div>
            <h1>👥 @Localizer["UsersManagement"]</h1>
            <p>@Localizer["ManageUserStatus"]</p>
        </div>
    </div>

    <div class="container-fluid mt-4">
        @if (TempData["Success"] != null)
        {
            <div class="subscription-alert success">
                <strong>@Localizer["Success"]</strong> @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="subscription-alert error">
                <strong>@Localizer["Error"]</strong> @TempData["Error"]
            </div>
        }

        <!-- Search Card -->
        <div class="booking-filters-card mb-4" style="background-color: var(--card-bg); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 12px; padding: 1.5rem; margin-bottom: 2rem; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);">
            <div class="row align-items-center">
                <div class="col-12">
                    <div class="search-input-wrapper">
                        <span style="position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: var(--autonomous); display: flex; align-items: center; z-index: 10;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                        </span>
                        <input class="form-control" id="searchInput" type="text" placeholder="@Localizer["SearchByNameOrEmail"]" />
                    </div>
                </div>
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="subscription-table" id="usersTable">
                    <thead>
                        <tr>
                            <th style="width: 30%;">@Localizer["FullName"]</th>
                            <th style="width: 40%;">@Localizer["EmailAddress"]</th>
                            <th style="width: 15%;">@Localizer["PhoneNumber"]</th>
                            <th style="width: 5%;">@Localizer["AccountStatus"]</th>
                            <th style="width: 10%; text-align: center;">@Localizer["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr class="user-row">
                                <td class="user-name">@user.FullName</td>
                                <td class="user-email">@user.Email</td>
                                <td>@(string.IsNullOrWhiteSpace(user.PhoneNumber) ? "-" : user.PhoneNumber)</td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="user-badge badge-emerald">@Localizer["Active"]</span>
                                    }
                                    else
                                    {
                                        <span class="user-badge badge-crimson">@Localizer["Inactive"]</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center gap-2 align-items-center">
                                        <a href="@Url.Action("Details", "UserManagement", new { id = user.Id })" class="action-icon-btn btn-action-view" data-tooltip="@Localizer["ViewDetails"]">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                                        </a>
                                        <a href="@Url.Action("Manage", "UserManagement", new { id = user.Id })" class="action-icon-btn btn-action-settings" data-tooltip="@Localizer["Manage"]">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                                        </a>
                                        <button type="button" class="action-icon-btn btn-action-delete" data-bs-toggle="modal" data-bs-target="#deleteConfirmModal" data-userid="@user.Id" data-tooltip="@Localizer["Delete"]">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            <div id="noUsersMatchMessage" class="subscription-empty-state" style="display: none;">
                <div class="subscription-empty-state-icon">🔍</div>
                <h3>@Localizer["NoMatchingUsersFound"]</h3>
                <p>@Localizer["NoUsersFound"]</p>
            </div>
        }
        else
        {
            <div class="subscription-empty-state">
                <div class="subscription-empty-state-icon">👥</div>
                <h3>@Localizer["NoUsersFound"]</h3>
                <p>@Localizer["NoUsersFound"]</p>
            </div>
        }
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade modal-dark" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteConfirmModalLabel">⚠️ @Localizer["ConfirmDeletion"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @Localizer["AreYouSureDeleteUser"]
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post" style="margin: 0;">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="submit" class="btn btn-subscription-danger" style="height: 38px;">@Localizer["Confirm"]</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Setup Delete Modal action assignment
            const deleteConfirmModal = document.getElementById('deleteConfirmModal');
            if (deleteConfirmModal) {
                deleteConfirmModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const userId = button.getAttribute('data-userid');
                    const form = document.getElementById('deleteForm');
                    form.action = '@Url.Action("Delete", "UserManagement")/' + userId;
                });
            }

            // Client-Side Live Search filtering
            const searchInput = document.getElementById('searchInput');
            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    const filter = this.value.toLowerCase().trim();
                    const rows = document.querySelectorAll('#usersTable tbody .user-row');
                    let visibleCount = 0;

                    rows.forEach(row => {
                        const nameEl = row.querySelector('.user-name');
                        const emailEl = row.querySelector('.user-email');
                        const nameText = nameEl ? nameEl.textContent.toLowerCase() : '';
                        const emailText = emailEl ? emailEl.textContent.toLowerCase() : '';

                        if (nameText.includes(filter) || emailText.includes(filter)) {
                            row.style.display = '';
                            visibleCount++;
                        } else {
                            row.style.display = 'none';
                        }
                    });

                    // Manage empty search state visualization
                    const tableWrap = document.querySelector('.table-responsive');
                    const emptyState = document.getElementById('noUsersMatchMessage');
                    if (emptyState && tableWrap) {
                        if (visibleCount === 0 && rows.length > 0) {
                            tableWrap.style.display = 'none';
                            emptyState.style.display = '';
                        } else {
                            tableWrap.style.display = '';
                            emptyState.style.display = 'none';
                        }
                    }
                });
            }
        });
    </script>
}
