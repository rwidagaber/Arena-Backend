@model ArenaMVC.Models.UserDetailsViewModel

@{
    ViewData["Title"] = "User Details";
}

<link rel="stylesheet" href="~/css/subscription-admin.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/user-admin.css" asp-append-version="true" />

<div class="subscription-admin-container">
    <div class="subscription-admin-header d-flex flex-wrap align-items-start justify-content-between gap-3">
        <div>
            <h1>ℹ️ User Details</h1>
            <p>Detailed view of user profile and account configuration.</p>
        </div>
        <div class="booking-header-actions">
            <a class="btn btn-subscription-secondary" asp-controller="UserManagement" asp-action="Index">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" style="margin-right: 6px; display: inline-block; vertical-align: middle;"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>Back to Users
            </a>
        </div>
    </div>

    <div class="container-fluid mt-4">
        <div class="user-details-grid">
            <!-- Profile Information Card -->
            <div class="user-details-card">
                <h3>👤 Profile Information</h3>
                <div class="user-detail-row">
                    <span class="user-detail-label">Full Name</span>
                    <span class="user-detail-value">@Model.FullName</span>
                </div>
                <div class="user-detail-row">
                    <span class="user-detail-label">Email Address</span>
                    <span class="user-detail-value">@Model.Email</span>
                </div>
                <div class="user-detail-row">
                    <span class="user-detail-label">Phone Number</span>
                    <span class="user-detail-value">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "-" : Model.PhoneNumber)</span>
                </div>
            </div>

            <!-- Account Information Card -->
            <div class="user-details-card">
                <h3>🛡️ Account Information</h3>
                <div class="user-detail-row">
                    <span class="user-detail-label">Account Status</span>
                    <span class="user-detail-value">
                        @if (Model.IsActive)
                        {
                            <span class="user-badge badge-emerald">Active</span>
                        }
                        else
                        {
                            <span class="user-badge badge-crimson">Inactive</span>
                        }
                    </span>
                </div>
                <div class="user-detail-row">
                    <span class="user-detail-label">Preferred Language</span>
                    <span class="user-detail-value" style="text-transform: uppercase;">@Model.PreferredLanguage</span>
                </div>
                <div class="user-detail-row">
                    <span class="user-detail-label">Register Date</span>
                    <span class="user-detail-value">@(Model.RegisterDate.HasValue ? Model.RegisterDate.Value.ToString("yyyy-MM-dd HH:mm:ss") : "N/A")</span>
                </div>
            </div>
        </div>
    </div>
</div>
