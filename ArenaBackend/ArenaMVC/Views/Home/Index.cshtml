@{
    ViewData["Title"] = Localizer["Arena"];
}

<style>
    .dashboard-header {
        margin-bottom: 2rem;
    }
    
    .dashboard-header h1 {
        font-size: 2.2rem;
        font-weight: 800;
        color: var(--whiteout);
        margin-bottom: 0.25rem;
    }
    
    .dashboard-header p {
        color: #A0A0AB;
        font-size: 1rem;
    }

    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2.5rem;
    }

    .metric-card {
        background-color: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 1.5rem;
        display: flex;
        align-items: center;
        gap: 1.25rem;
        transition: all 0.3s ease;
    }

    .metric-card:hover {
        border-color: rgba(213, 235, 69, 0.4);
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    }

    html[data-theme="light"] .metric-card:hover {
        border-color: #367FDD;
    }

    .metric-icon {
        width: 48px;
        height: 48px;
        background-color: rgba(213, 235, 69, 0.1);
        border: 1px solid rgba(213, 235, 69, 0.2);
        color: var(--yellow);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .metric-info {
        display: flex;
        flex-direction: column;
    }

    .metric-label {
        font-size: 0.85rem;
        color: #71717A;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .metric-value {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--whiteout);
        line-height: 1.2;
        margin: 2px 0;
    }

    .metric-change {
        font-size: 0.8rem;
        color: #10B981;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .metric-change.negative {
        color: #EF4444;
    }

    .dashboard-layout {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 1.5rem;
        margin-bottom: 2.5rem;
    }

    @@media (max-width: 992px) {
        .dashboard-layout {
            grid-template-columns: 1fr;
        }
    }

    .chart-card {
        min-height: 350px;
    }

    .chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .chart-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--whiteout);
    }

    .chart-legend {
        display: flex;
        gap: 12px;
        font-size: 0.8rem;
        color: #A0A0AB;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .legend-color {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    .mock-chart-container {
        width: 100%;
        height: 220px;
        position: relative;
    }

    .mock-chart-svg {
        width: 100%;
        height: 100%;
    }

    .recent-checkins-card {
        display: flex;
        flex-direction: column;
    }

    .checkin-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: 1rem;
        flex: 1;
    }

    .checkin-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--border-color);
    }

    .checkin-item:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .avatar {
        width: 38px;
        height: 38px;
        background-color: var(--teal);
        color: var(--whiteout);
        font-weight: 600;
        font-size: 0.9rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-transform: uppercase;
    }

    .checkin-details {
        flex: 1;
    }

    .member-name {
        font-weight: 600;
        color: var(--whiteout);
        font-size: 0.95rem;
    }

    .plan-badge {
        font-size: 0.75rem;
        background-color: rgba(111, 135, 134, 0.15);
        color: var(--teal);
        padding: 2px 8px;
        border-radius: 20px;
        display: inline-block;
        margin-top: 2px;
    }

    .checkin-time {
        font-size: 0.8rem;
        color: #71717A;
    }

    .shortcuts-card {
        margin-bottom: 1.5rem;
    }

    .shortcuts-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-top: 1rem;
    }

    .shortcut-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 1.25rem;
        background-color: var(--input-bg);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        color: var(--whiteout);
        font-weight: 500;
        font-size: 0.9rem;
        gap: 8px;
        transition: all 0.3s ease;
        text-align: center;
    }

    .shortcut-btn:hover {
        background-color: var(--hover-bg);
        border-color: var(--yellow);
        color: var(--yellow);
        transform: translateY(-2px);
    }

    .shortcut-icon {
        width: 24px;
        height: 24px;
        color: var(--yellow);
    }
</style>

<div class="dashboard-header">
    <h1>@Localizer["Welcome1"]</h1>
    <p>@Localizer["subWelcom"]</p>
</div>

<!-- Metrics Dashboard Grid -->
<div class="metrics-grid">
    <div class="metric-card">
        <div class="metric-icon"><i data-lucide="users"></i></div>
        <div class="metric-info">
            <span class="metric-label">Total Members</span>
            <span class="metric-value">1,482</span>
            <span class="metric-change">▲ 12% this month</span>
        </div>
    </div>
    
    <div class="metric-card">
        <div class="metric-icon"><i data-lucide="trending-up"></i></div>
        <div class="metric-info">
            <span class="metric-label">Active Subscriptions</span>
            <span class="metric-value">954</span>
            <span class="metric-change">▲ 4.8% this week</span>
        </div>
    </div>
    
    <div class="metric-card">
        <div class="metric-icon"><i data-lucide="dollar-sign"></i></div>
        <div class="metric-info">
            <span class="metric-label">Monthly Revenue</span>
            <span class="metric-value">$18,450</span>
            <span class="metric-change">▲ 8.2% vs last month</span>
        </div>
    </div>
    
    <div class="metric-card">
        <div class="metric-icon"><i data-lucide="key"></i></div>
        <div class="metric-info">
            <span class="metric-label">@Localizer["ActivePlans"]</span>
            <span class="metric-value">@ViewBag.ActivePlans @Localizer["Plans1"]</span>
            <span class="metric-change">@ViewBag.TotalPlans @Localizer["TotalPlans"] </span>
        </div>
    </div>
</div>

<!-- Main Layout Grid -->
<div class="dashboard-layout">
    <!-- Line Chart Component -->
    <div class="dashboard-card chart-card">
        <div class="chart-header">
            <h2 class="chart-title">Weekly Arena Attendance & Check-ins</h2>
            <div class="chart-legend">
                <div class="legend-item">
                    <span class="legend-color" style="background-color: var(--yellow);"></span>
                    <span>Peak Hours Check-ins</span>
                </div>
                <div class="legend-item">
                    <span class="legend-color" style="background-color: var(--teal);"></span>
                    <span>Normal Hours Check-ins</span>
                </div>
            </div>
        </div>
        
        <div class="mock-chart-container">
            <svg class="mock-chart-svg" viewBox="0 0 500 200" preserveAspectRatio="none">
                <!-- Grid Lines -->
                <line x1="0" y1="50" x2="500" y2="50" stroke="var(--border-color)" stroke-dasharray="4" stroke-width="1" />
                <line x1="0" y1="100" x2="500" y2="100" stroke="var(--border-color)" stroke-dasharray="4" stroke-width="1" />
                <line x1="0" y1="150" x2="500" y2="150" stroke="var(--border-color)" stroke-dasharray="4" stroke-width="1" />
                
                <!-- SVG Area Gradients -->
                <defs>
                    <linearGradient id="yellowGradient" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="var(--yellow)" stop-opacity="0.3"/>
                        <stop offset="100%" stop-color="var(--yellow)" stop-opacity="0.0"/>
                    </linearGradient>
                </defs>
                
                <!-- Area path underneath line -->
                <path d="M 0 150 Q 80 80 160 110 T 320 60 T 480 40 L 480 200 L 0 200 Z" fill="url(#yellowGradient)" />
                
                <!-- Glow Line Chart -->
                <path d="M 0 150 Q 80 80 160 110 T 320 60 T 480 40" fill="none" stroke="var(--yellow)" stroke-width="4" stroke-linecap="round" />
                
                <!-- Data Points -->
                <circle cx="80" cy="115" r="5" fill="var(--yellow)" stroke="var(--card-bg)" stroke-width="2" />
                <circle cx="160" cy="110" r="5" fill="var(--yellow)" stroke="var(--card-bg)" stroke-width="2" />
                <circle cx="240" cy="85" r="5" fill="var(--yellow)" stroke="var(--card-bg)" stroke-width="2" />
                <circle cx="320" cy="60" r="5" fill="var(--yellow)" stroke="var(--card-bg)" stroke-width="2" />
                <circle cx="400" cy="50" r="5" fill="var(--yellow)" stroke="var(--card-bg)" stroke-width="2" />
                <circle cx="480" cy="40" r="5" fill="var(--yellow)" stroke="var(--card-bg)" stroke-width="2" />
                
                <!-- X-Axis Labels -->
                <text x="5" y="190" fill="var(--text-secondary)" font-size="11" font-family="Outfit">Mon</text>
                <text x="85" y="190" fill="var(--text-secondary)" font-size="11" font-family="Outfit">Tue</text>
                <text x="165" y="190" fill="var(--text-secondary)" font-size="11" font-family="Outfit">Wed</text>
                <text x="245" y="190" fill="var(--text-secondary)" font-size="11" font-family="Outfit">Thu</text>
                <text x="325" y="190" fill="var(--text-secondary)" font-size="11" font-family="Outfit">Fri</text>
                <text x="405" y="190" fill="var(--text-secondary)" font-size="11" font-family="Outfit">Sat</text>
                <text x="465" y="190" fill="var(--text-secondary)" font-size="11" font-family="Outfit">Sun</text>
            </svg>
        </div>
    </div>
    
    <!-- Sidebar column: Quick Actions & Live feed -->
    <div>
        <!-- Quick shortcuts -->
  
    <div>
        <div class="dashboard-card shortcuts-card">
            <h3 class="chart-title">@Localizer["QuickAdministration"]</h3>
            <div class="shortcuts-grid">
                <a href="@Url.Action("Create", "SubscriptionPlans")" class="shortcut-btn">
                    <i data-lucide="plus" class="shortcut-icon"></i>
                    <span>@Localizer["CreateSubscriptionPlan"]</span>
                </a>
                <a href="@Url.Action("Index", "SubscriptionPlans")" class="shortcut-btn">
                    <i data-lucide="clipboard-list" class="shortcut-icon"></i>
                    <span>@Localizer["SubscriptionPlans"]</span>
                </a>
                <a href="@Url.Action("Privacy", "Home")" class="shortcut-btn" style="grid-column: span 2;">
                    <i data-lucide="shield" class="shortcut-icon"></i>
                    <span>@Localizer["Privacy"]</span>
                </a>
            </div>
        </div>

        
        <!-- Recent Check-ins -->
        <div class="dashboard-card recent-checkins-card">
            <h3 class="chart-title">Live Gym Check-ins</h3>
            <div class="checkin-list">
                <div class="checkin-item">
                    <div class="avatar" style="background-color: #8B5CF6;">JS</div>
                    <div class="checkin-details">
                        <div class="member-name">John Smith</div>
                        <div class="plan-badge">Vanguard Gym Premium</div>
                    </div>
                    <div class="checkin-time">10 mins ago</div>
                </div>
                <div class="checkin-item">
                    <div class="avatar" style="background-color: #3B82F6;">AM</div>
                    <div class="checkin-details">
                        <div class="member-name">Amir Mahmoud</div>
                        <div class="plan-badge">Arena Standard</div>
                    </div>
                    <div class="checkin-time">14 mins ago</div>
                </div>
                <div class="checkin-item">
                    <div class="avatar" style="background-color: #10B981;">WN</div>
                    <div class="checkin-details">
                        <div class="member-name">Wael Nabil</div>
                        <div class="plan-badge">Elite Athlete VIP</div>
                    </div>
                    <div class="checkin-time">18 mins ago</div>
                </div>
            </div>
        </div>
    </div>
</div>

