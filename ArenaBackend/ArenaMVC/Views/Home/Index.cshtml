@{
    ViewData["Title"] = Localizer["Arena"];
}

<style>
    .dashboard-header {
        margin-bottom: 2rem;
    }
    
    .dashboard-header h1 {
        font-size: 2.2rem;
        font-weight: 800;
        color: var(--whiteout);
        margin-bottom: 0.25rem;
    }
    
    .dashboard-header p {
        color: #A0A0AB;
        font-size: 1rem;
    }

    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2.5rem;
    }

    .metric-card {
        background-color: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 1.5rem;
        display: flex;
        align-items: center;
        gap: 1.25rem;
        transition: all 0.3s ease;
    }

    .metric-card:hover {
        border-color: rgba(196, 176, 69, 0.4);
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    }

    .metric-icon {
        width: 48px;
        height: 48px;
        background-color: rgba(196, 176, 69, 0.1);
        border: 1px solid rgba(196, 176, 69, 0.2);
        color: var(--yellow);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .metric-info {
        display: flex;
        flex-direction: column;
    }

    .metric-label {
        font-size: 0.85rem;
        color: #71717A;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .metric-value {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--whiteout);
        line-height: 1.2;
        margin: 2px 0;
    }

    .metric-change {
        font-size: 0.8rem;
        color: #10B981;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .metric-change.negative {
        color: #EF4444;
    }

    .dashboard-layout {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 1.5rem;
        margin-bottom: 2.5rem;
    }

    @@media (max-width: 992px) {
        .dashboard-layout {
            grid-template-columns: 1fr;
        }
    }

    .chart-card {
        min-height: 350px;
    }

    .chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .chart-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--whiteout);
    }

    .chart-legend {
        display: flex;
        gap: 12px;
        font-size: 0.8rem;
        color: #A0A0AB;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .legend-color {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    .mock-chart-container {
        width: 100%;
        height: 220px;
        position: relative;
    }

    .mock-chart-svg {
        width: 100%;
        height: 100%;
    }

    .recent-checkins-card {
        display: flex;
        flex-direction: column;
    }

    .checkin-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: 1rem;
        flex: 1;
    }

    .checkin-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--border-color);
    }

    .checkin-item:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .avatar {
        width: 38px;
        height: 38px;
        background-color: var(--teal);
        color: var(--whiteout);
        font-weight: 600;
        font-size: 0.9rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-transform: uppercase;
    }

    .checkin-details {
        flex: 1;
    }

    .member-name {
        font-weight: 600;
        color: var(--whiteout);
        font-size: 0.95rem;
    }

    .plan-badge {
        font-size: 0.75rem;
        background-color: rgba(111, 135, 134, 0.15);
        color: var(--teal);
        padding: 2px 8px;
        border-radius: 20px;
        display: inline-block;
        margin-top: 2px;
    }

    .checkin-time {
        font-size: 0.8rem;
        color: #71717A;
    }

    .shortcuts-card {
        margin-bottom: 1.5rem;
    }

    .shortcuts-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-top: 1rem;
    }

    .shortcut-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 1.25rem;
        background-color: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        color: var(--whiteout);
        font-weight: 500;
        font-size: 0.9rem;
        gap: 8px;
        transition: all 0.3s ease;
        text-align: center;
    }

    .shortcut-btn:hover {
        background-color: rgba(196, 176, 69, 0.08);
        border-color: var(--yellow);
        color: var(--yellow);
        transform: translateY(-2px);
    }

    .shortcut-icon {
        font-size: 1.5rem;
    }
</style>

<div class="dashboard-header">
    <h1>@Localizer["Welcome"]</h1>
    <p>@Localizer["Arena"]</p>
</div>

<div class="metrics-grid">
    <div class="metric-card">
        <div class="metric-icon">👥</div>
        <div class="metric-info">
            <span class="metric-label">@Localizer["TotalPlans"]</span>
            <span class="metric-value">@ViewBag.TotalPlans</span>
        </div>
    </div>
    
    <div class="metric-card">
        <div class="metric-icon">📈</div>
        <div class="metric-info">
            <span class="metric-label">@Localizer["ActivePlans"]</span>
            <span class="metric-value">@ViewBag.ActivePlans</span>
        </div>
    </div>
</div>

<div class="dashboard-layout">
    <div class="dashboard-card chart-card">
        <div class="chart-header">
            <h2 class="chart-title">@Localizer["Arena"]</h2>
        </div>
    </div>
    
    <div>
        <div class="dashboard-card shortcuts-card">
            <h3 class="chart-title">@Localizer["Create"]</h3>
            <div class="shortcuts-grid">
                <a href="@Url.Action("Create", "SubscriptionPlans")" class="shortcut-btn">
                    <span class="shortcut-icon">➕</span>
                    <span>@Localizer["Create"]</span>
                </a>
                <a href="@Url.Action("Index", "SubscriptionPlans")" class="shortcut-btn">
                    <span class="shortcut-icon">📋</span>
                    <span>@Localizer["SubscriptionPlans"]</span>
                </a>
                <a href="@Url.Action("Privacy", "Home")" class="shortcut-btn" style="grid-column: span 2;">
                    <span class="shortcut-icon">🛡️</span>
                    <span>@Localizer["Privacy"]</span>
                </a>
            </div>
        </div>
    </div>
</div>
