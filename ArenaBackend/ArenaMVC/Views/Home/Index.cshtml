@using ArenaApplication.Dtos.Dashboard
@model AdminDashboardDto
@{
    ViewData["Title"] = Localizer["Arena"];

    // Pre-calculate chart dimensions for the SVG
    var maxAttendance = Model.WeeklyAttendance.Any() ? Model.WeeklyAttendance.Max(a => a.Count) : 1;
    if (maxAttendance == 0) maxAttendance = 1;
    var chartWidth = 480;
    var chartHeight = 170;
    var chartPadding = 20;
    var usableWidth = chartWidth - (chartPadding * 2);
    var dayCount = Model.WeeklyAttendance.Count;
    var daySpacing = dayCount > 1 ? usableWidth / (dayCount - 1) : 0;
}

<style>
    .dashboard-header {
        margin-bottom: 2rem;
    }
    
    .dashboard-header h1 {
        font-size: 2.2rem;
        font-weight: 800;
        color: var(--whiteout);
        margin-bottom: 0.25rem;
    }
    
    .dashboard-header p {
        color: #A0A0AB;
        font-size: 1rem;
    }

    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2.5rem;
    }

    .metric-card {
        background-color: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 1.5rem;
        display: flex;
        align-items: center;
        gap: 1.25rem;
        transition: all 0.3s ease;
    }

    .metric-card:hover {
        border-color: rgba(213, 235, 69, 0.4);
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    }

    .metric-icon {
        width: 48px;
        height: 48px;
        background-color: rgba(213, 235, 69, 0.1);
        border: 1px solid rgba(213, 235, 69, 0.2);
        color: var(--yellow);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .metric-info {
        display: flex;
        flex-direction: column;
    }

    .metric-label {
        font-size: 0.85rem;
        color: #71717A;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .metric-value {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--whiteout);
        line-height: 1.2;
        margin: 2px 0;
    }

    .metric-change {
        font-size: 0.8rem;
        color: #10B981;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .metric-change.negative {
        color: #EF4444;
    }

    .dashboard-layout {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 1.5rem;
        margin-bottom: 2.5rem;
    }

    @@media (max-width: 992px) {
        .dashboard-layout {
            grid-template-columns: 1fr;
        }
    }

    .chart-card {
        min-height: 350px;
    }

    .chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .chart-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--whiteout);
    }

    .chart-legend {
        display: flex;
        gap: 12px;
        font-size: 0.8rem;
        color: #A0A0AB;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .legend-color {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    .mock-chart-container {
        width: 100%;
        height: 220px;
        position: relative;
    }

    .mock-chart-svg {
        width: 100%;
        height: 100%;
    }

    .recent-checkins-card {
        display: flex;
        flex-direction: column;
    }

    .checkin-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: 1rem;
        flex: 1;
    }

    .checkin-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--border-color);
    }

    .checkin-item:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .avatar {
        width: 38px;
        height: 38px;
        background-color: var(--teal);
        color: var(--whiteout);
        font-weight: 600;
        font-size: 0.9rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-transform: uppercase;
    }

    .checkin-details {
        flex: 1;
    }

    .member-name {
        font-weight: 600;
        color: var(--whiteout);
        font-size: 0.95rem;
    }

    .plan-badge {
        font-size: 0.75rem;
        background-color: rgba(111, 135, 134, 0.15);
        color: var(--teal);
        padding: 2px 8px;
        border-radius: 20px;
        display: inline-block;
        margin-top: 2px;
    }

    .checkin-time {
        font-size: 0.8rem;
        color: #71717A;
    }

    .shortcuts-card {
        margin-bottom: 1.5rem;
    }

    .shortcuts-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-top: 1rem;
    }

    .shortcut-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 1.25rem;
        background-color: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        color: var(--whiteout);
        font-weight: 500;
        font-size: 0.9rem;
        gap: 8px;
        transition: all 0.3s ease;
        text-align: center;
    }

    .shortcut-btn:hover {
        background-color: rgba(213, 235, 69, 0.08);
        border-color: var(--yellow);
        color: var(--yellow);
        transform: translateY(-2px);
    }

    .shortcut-icon {
        font-size: 1.5rem;
    }

    .empty-checkins {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        color: #71717A;
        font-size: 0.9rem;
        text-align: center;
        flex: 1;
    }

    .empty-checkins-icon {
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
        opacity: 0.5;
    }
</style>

<div class="dashboard-header">
    <h1>@Localizer["Welcome1"]</h1>
    <p>@Localizer["subWelcom"]</p>
</div>

<!-- Metrics Dashboard Grid -->
<div class="metrics-grid">
    <!-- Total Members -->
    <div class="metric-card">
        <div class="metric-icon">👥</div>
        <div class="metric-info">
            <span class="metric-label">Total Members</span>
            <span class="metric-value">@Model.TotalMembers.ToString("N0")</span>
            <span class="metric-change @(Model.MemberGrowthPercent < 0 ? "negative" : "")">
                @(Model.MemberGrowthPercent >= 0 ? "▲" : "▼") @Math.Abs(Model.MemberGrowthPercent)% this month
            </span>
        </div>
    </div>
    
    <!-- Active Subscriptions -->
    <div class="metric-card">
        <div class="metric-icon">📈</div>
        <div class="metric-info">
            <span class="metric-label">Active Subscriptions</span>
            <span class="metric-value">@Model.ActiveSubscriptions.ToString("N0")</span>
            <span class="metric-change @(Model.SubscriptionGrowthPercent < 0 ? "negative" : "")">
                @(Model.SubscriptionGrowthPercent >= 0 ? "▲" : "▼") @Math.Abs(Model.SubscriptionGrowthPercent)% this month
            </span>
        </div>
    </div>
    
    <!-- Monthly Revenue -->
    <div class="metric-card">
        <div class="metric-icon">💰</div>
        <div class="metric-info">
            <span class="metric-label">Monthly Revenue</span>
            <span class="metric-value">@Model.MonthlyRevenue.ToString("N0") EGP</span>
            <span class="metric-change @(Model.RevenueGrowthPercent < 0 ? "negative" : "")">
                @(Model.RevenueGrowthPercent >= 0 ? "▲" : "▼") @Math.Abs(Model.RevenueGrowthPercent)% vs last month
            </span>
        </div>
    </div>
    
    <!-- Active Plans -->
    <div class="metric-card">
        <div class="metric-icon">🔑</div>
        <div class="metric-info">
            <span class="metric-label">@Localizer["ActivePlans"]</span>
            <span class="metric-value">@Model.ActivePlans @Localizer["Plans1"]</span>
            <span class="metric-change">@Model.TotalPlans @Localizer["TotalPlans"]</span>
        </div>
    </div>

    <!-- Expiring Subscriptions -->
    <div class="metric-card">
        <div class="metric-icon">⏳</div>
        <div class="metric-info">
            <span class="metric-label">Expiring Soon</span>
            <span class="metric-value">@Model.ExpiringSubscriptions</span>
            <span class="metric-change @(Model.ExpiringSubscriptions > 0 ? "negative" : "")">
                @(Model.ExpiringSubscriptions > 0 ? "⚠" : "✓") Within 7 days
            </span>
        </div>
    </div>

    <!-- Today's Attendance -->
    <div class="metric-card">
        <div class="metric-icon">🏋️</div>
        <div class="metric-info">
            <span class="metric-label">Today's Attendance</span>
            <span class="metric-value">@Model.TodayAttendance</span>
            <span class="metric-change">Check-ins today</span>
        </div>
    </div>
</div>

<!-- Main Layout Grid -->
<div class="dashboard-layout">
    <!-- Line Chart Component -->
    <div class="dashboard-card chart-card">
        <div class="chart-header">
            <h2 class="chart-title">Weekly Arena Attendance &amp; Check-ins</h2>
            <div class="chart-legend">
                <div class="legend-item">
                    <span class="legend-color" style="background-color: var(--yellow);"></span>
                    <span>Check-ins</span>
                </div>
            </div>
        </div>
        
        <div class="mock-chart-container">
            <svg class="mock-chart-svg" viewBox="0 0 520 220" preserveAspectRatio="none">
                <!-- Grid Lines -->
                <line x1="20" y1="50" x2="500" y2="50" stroke="#252529" stroke-dasharray="4" stroke-width="1" />
                <line x1="20" y1="100" x2="500" y2="100" stroke="#252529" stroke-dasharray="4" stroke-width="1" />
                <line x1="20" y1="150" x2="500" y2="150" stroke="#252529" stroke-dasharray="4" stroke-width="1" />
                
                <!-- SVG Area Gradients -->
                <defs>
                    <linearGradient id="yellowGradient" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="var(--yellow)" stop-opacity="0.3"/>
                        <stop offset="100%" stop-color="var(--yellow)" stop-opacity="0.0"/>
                    </linearGradient>
                </defs>
                
                @if (Model.WeeklyAttendance.Any(a => a.Count > 0))
                {
                    // Calculate Y positions for each day
                    var points = new List<(int X, int Y)>();
                    for (int i = 0; i < dayCount; i++)
                    {
                        var x = chartPadding + (i * daySpacing);
                        var ratio = (double)Model.WeeklyAttendance[i].Count / maxAttendance;
                        var y = (int)(chartHeight - (ratio * (chartHeight - 30)) + 10);
                        points.Add((x, y));
                    }

                    // Build SVG path
                    var pathPoints = string.Join(" L ", points.Select(p => $"{p.X} {p.Y}"));
                    var linePath = $"M {pathPoints}";
                    var areaPath = $"M {pathPoints} L {points.Last().X} 200 L {points.First().X} 200 Z";

                    <!-- Area Fill -->
                    <path d="@areaPath" fill="url(#yellowGradient)" />
                    <!-- Line -->
                    <path d="@linePath" fill="none" stroke="var(--yellow)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />

                    // Data point circles
                    foreach (var point in points)
                    {
                        <circle cx="@point.X" cy="@point.Y" r="5" fill="var(--yellow)" stroke="#16161A" stroke-width="2" />
                    }
                }
                else
                {
                    <!-- Flat line when no data -->
                    <line x1="@chartPadding" y1="170" x2="@(chartPadding + usableWidth)" y2="170" stroke="var(--yellow)" stroke-width="2" stroke-opacity="0.3" />
                }
                
                <!-- X-Axis Labels -->
                @for (int i = 0; i < Model.WeeklyAttendance.Count; i++)
                {
                    var xPos = chartPadding + (i * daySpacing);
                    @Html.Raw($"<text x=\"{xPos}\" y=\"210\" fill=\"#71717A\" font-size=\"11\" font-family=\"Outfit\" text-anchor=\"middle\">{Model.WeeklyAttendance[i].DayName}</text>")
                }
            </svg>
        </div>
    </div>
    
    <!-- Sidebar column: Quick Actions & Live feed -->
    <div>
        <!-- Quick shortcuts -->
    <div>
        <div class="dashboard-card shortcuts-card">
            <h3 class="chart-title">@Localizer["QuickAdministration"]</h3>
            <div class="shortcuts-grid">
                <a href="@Url.Action("Create", "SubscriptionPlans")" class="shortcut-btn">
                    <span class="shortcut-icon">➕</span>
                    <span>@Localizer["CreateSubscriptionPlan"]</span>
                </a>
                <a href="@Url.Action("Index", "SubscriptionPlans")" class="shortcut-btn">
                    <span class="shortcut-icon">📋</span>
                    <span>@Localizer["SubscriptionPlans"]</span>
                </a>
                <a href="@Url.Action("Privacy", "Home")" class="shortcut-btn" style="grid-column: span 2;">
                    <span class="shortcut-icon">🛡️</span>
                    <span>@Localizer["Privacy"]</span>
                </a>
            </div>
        </div>

        
        <!-- Recent Check-ins -->
        <div class="dashboard-card recent-checkins-card">
            <h3 class="chart-title">Live Gym Check-ins</h3>
            @if (Model.RecentCheckIns.Any())
            {
                <div class="checkin-list">
                    @foreach (var checkIn in Model.RecentCheckIns)
                    {
                        <div class="checkin-item">
                            <div class="avatar" style="background-color: @checkIn.AvatarColor;">@checkIn.Initials</div>
                            <div class="checkin-details">
                                <div class="member-name">@checkIn.MemberName</div>
                                <div class="plan-badge">@checkIn.PlanName</div>
                            </div>
                            <div class="checkin-time">@checkIn.TimeAgo</div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-checkins">
                    <div class="empty-checkins-icon">🏋️</div>
                    <span>No check-ins yet today</span>
                </div>
            }
        </div>
    </div>
</div>
