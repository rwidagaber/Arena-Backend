@model ArenaApplication.Dtos.Workout.ExerciseCatalogItemDto
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["CreateExercise"];
    var equipments = ViewBag.Equipments as List<ArenaApplication.Dtos.Gym.EquipmentDto> ?? new List<ArenaApplication.Dtos.Gym.EquipmentDto>();
}

<link rel="stylesheet" href="~/css/subscription-admin.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/user-admin.css" asp-append-version="true" />

<div class="subscription-admin-container">
    <div class="subscription-admin-header d-flex flex-wrap align-items-start justify-content-between gap-3">
        <div>
            <h1><i data-lucide="plus-circle" style="width: 32px; height: 32px; vertical-align: middle; margin-inline-end: 8px;"></i>@Localizer["CreateExercise"]</h1>
            <p>@Localizer["AddExerciseToCatalog"]</p>
        </div>
        <div class="booking-header-actions">
            <a class="btn btn-subscription-secondary d-inline-flex align-items-center gap-1" asp-controller="ExerciseCatalog" asp-action="Index">
                <i data-lucide="arrow-left" style="width: 14px; height: 14px;"></i>@Localizer["BackToList"]
            </a>
        </div>
    </div>

    <div class="container-fluid mt-4">
        @if (TempData["Error"] != null)
        {
            <div class="subscription-alert error">
                <strong>@Localizer["Error"]</strong> @TempData["Error"]
            </div>
        }

        <div class="row justify-content-center" style="padding-top: 2rem; padding-bottom: 4rem;">
            <div class="col-lg-8 col-md-10">
                <div class="manage-user-card" style="background-color: var(--card-bg); padding: 2rem; border-radius: 12px; border: 1px solid var(--border-color); box-shadow: var(--card-shadow);">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <div class="subscription-form-group">
                                    <label asp-for="Name" style="color: var(--yellow); font-weight: 600; margin-bottom: 0.5rem; display: block;">
                                        @Html.DisplayNameFor(m => m.Name) <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="Name" class="form-control" placeholder="@Localizer["EnterExerciseName"]" style="background-color: var(--body-bg); border-color: var(--border-color); color: var(--foreground);" />
                                    <span asp-validation-for="Name" class="text-danger small"></span>
                                </div>
                            </div>
                            
                            <div class="col-md-6 mb-4">
                                <div class="subscription-form-group">
                                    <label asp-for="MuscleGroup" style="color: var(--yellow); font-weight: 600; margin-bottom: 0.5rem; display: block;">
                                        @Html.DisplayNameFor(m => m.MuscleGroup) <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="MuscleGroup" class="form-control" placeholder="@Localizer["EnterMuscleGroup"]" style="background-color: var(--body-bg); border-color: var(--border-color); color: var(--foreground);" />
                                    <span asp-validation-for="MuscleGroup" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <div class="subscription-form-group">
                                    <label asp-for="DifficultyLevel" style="color: var(--yellow); font-weight: 600; margin-bottom: 0.5rem; display: block;">
                                        @Html.DisplayNameFor(m => m.DifficultyLevel) <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="DifficultyLevel" class="form-select form-control" style="background-color: var(--body-bg); border-color: var(--border-color); color: var(--foreground);">
                                        <option value="Beginner">@Localizer["Beginner"]</option>
                                        <option value="Intermediate">@Localizer["Intermediate"]</option>
                                        <option value="Advanced">@Localizer["Advanced"]</option>
                                    </select>
                                    <span asp-validation-for="DifficultyLevel" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="subscription-form-group">
                                <label asp-for="Description" style="color: var(--yellow); font-weight: 600; margin-bottom: 0.5rem; display: block;">
                                    @Html.DisplayNameFor(m => m.Description)
                                </label>
                                <textarea asp-for="Description" class="form-control" rows="3" placeholder="@Localizer["EnterDescription"]" style="background-color: var(--body-bg); border-color: var(--border-color); color: var(--foreground); height: auto;"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label style="color: var(--yellow); font-weight: 600; margin-bottom: 0.8rem; display: block;">
                                @Localizer["RequiredEquipment"]
                            </label>
                            @if (!equipments.Any())
                            {
                                <p class="text-muted">@Localizer["NoEquipmentsAvailable"]</p>
                            }
                            else
                            {
                                <div class="row g-3">
                                    @foreach (var eq in equipments)
                                    {
                                        <div class="col-md-4 col-sm-6">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="EquipmentIds" value="@eq.Id" id="eq_@eq.Id" @(Model.EquipmentIds.Contains(eq.Id) ? "checked" : "") style="background-color: var(--body-bg); border-color: var(--border-color);" />
                                                <label class="form-check-label text-foreground" for="eq_@eq.Id">
                                                    @eq.Name
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <div class="d-flex gap-3 mt-4 pt-4 border-top" style="border-color: var(--border-color) !important;">
                            <button type="submit" class="btn btn-subscription-primary" style="flex: 1; padding: 0.75rem 1.5rem; font-weight: 600;">@Localizer["Create"]</button>
                            <a asp-action="Index" class="btn btn-ghost" style="flex: 1;">@Localizer["Cancel"]</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
