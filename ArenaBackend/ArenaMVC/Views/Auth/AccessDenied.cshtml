@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ArenaLocalization> Localizer

@{
    ViewData["Title"] = Localizer["AccessDenied"];
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<div class="login-card access-denied-card" dir="ltr">
    <div class="access-denied-icon">
        <i data-lucide="shield-x"></i>
    </div>
    <h1 class="login-title">@Localizer["AccessDenied"]</h1>
    <p class="login-subtitle">@Localizer["AdminOnlyAccess"]</p>
    <a asp-controller="Auth" asp-action="Login" class="login-btn-submit access-denied-back">
        <span class="login-btn-text">@Localizer["BackToLogin"]</span>
    </a>
</div>
