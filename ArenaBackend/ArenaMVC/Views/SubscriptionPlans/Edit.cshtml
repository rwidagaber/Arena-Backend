@model ArenaApplication.Dtos.SubscriptionPlanDtos.SubscriptionPlanDto

@{
	ViewData["Title"] = Localizer["EditSubscriptionPlan"];
}

<link rel="stylesheet" href="~/css/subscription-admin.css" />

<style>
    .status-toggle-label {
        display: flex;
        align-items: center;
        cursor: pointer;
        user-select: none;
        width: 100%;
        max-width: 200px;
    }

    .status-toggle-pill {
        display: flex;
        align-items: center;
        position: relative;
        width: 100%;
        height: 44px;
        background: #EF4444; /* Default: Inactive (Red) */
        border: 1.5px solid #EF4444;
        border-radius: 50px;
        padding: 4px;
        transition: background 0.3s ease, border-color 0.3s ease;
        overflow: hidden;
    }

    .status-toggle-pill .pill-thumb {
        position: absolute;
        top: 4px;
        inset-inline-start: 4px;
        width: calc(50% - 4px);
        height: calc(100% - 8px);
        background: var(--card-bg, #ffffff);
        border-radius: 50px;
        transition: inset-inline-start 0.3s cubic-bezier(0.4, 0, 0.2, 1), background 0.3s ease;
        z-index: 1;
        box-shadow: 0 2px 5px rgba(0,0,0,0.15);
    }

    .status-toggle-pill .pill-inactive,
    .status-toggle-pill .pill-active {
        position: relative;
        z-index: 2;
        flex: 1;
        text-align: center;
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        transition: color 0.3s ease;
    }

    /* Unchecked (Inactive) */
    .status-toggle-pill .pill-inactive { color: #EF4444; }
    .status-toggle-pill .pill-active { color: rgba(255, 255, 255, 0.85); }

    /* Checked (Active) */
    #isActiveCheckbox:checked ~ .status-toggle-pill {
        background: #10B981;
        border-color: #10B981;
    }

    #isActiveCheckbox:checked ~ .status-toggle-pill .pill-thumb {
        inset-inline-start: 50%;
    }

    #isActiveCheckbox:checked ~ .status-toggle-pill .pill-inactive { color: rgba(255, 255, 255, 0.85); }
    #isActiveCheckbox:checked ~ .status-toggle-pill .pill-active { color: #10B981; }
</style>

<div class="subscription-admin-container">
	<div class="subscription-admin-header">
		<h1><i data-lucide="edit-3" style="width: 32px; height: 32px; vertical-align: middle; margin-inline-end: 8px;"></i>@Localizer["EditSubscriptionPlan"]</h1>
		<p>@Localizer["UpdateSubscriptionPlanDetails"]</p>
	</div>

	<div class="container-fluid mt-4">
		<div class="row">
			<div class="col-lg-8 offset-lg-2">
				@if (!ViewData.ModelState.IsValid)
				{
					<div class="subscription-alert error">
						<strong>@Localizer["PleaseFixErrors"]</strong>
						<ul style="margin-top: 0.5rem; margin-bottom: 0;">
							@foreach (var modelState in ViewData.ModelState.Values)
							{
								@foreach (var error in modelState.Errors)
								{
									<li>@error.ErrorMessage</li>
								}
							}
						</ul>
					</div>
				}

				<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="subscription-form">
					<input type="hidden" asp-for="Id" />

					<div class="row">
						<div class="col-md-6">
							<div class="subscription-form-group">
								<label asp-for="NameEn">@Localizer["PlanNameEnglish"] *</label>
								<input asp-for="NameEn" type="text" placeholder="@Localizer["PlanNameEnglishPlaceholder"]" class="form-control" required />
								<span asp-validation-for="NameEn" class="text-danger"></span>
							</div>
						</div>
						<div class="col-md-6">
							<div class="subscription-form-group">
								<label asp-for="NameAr">@Localizer["PlanNameArabic"] *</label>
								<input asp-for="NameAr" type="text" placeholder="مثال: بريميوم بلس" class="form-control" required />
								<span asp-validation-for="NameAr" class="text-danger"></span>
							</div>
						</div>
					</div>

					<div class="row">
						<div class="col-md-6">
							<div class="subscription-form-group">
								<label asp-for="DescriptionEn">@Localizer["DescriptionEnglish"] *</label>
								<textarea asp-for="DescriptionEn" placeholder="@Localizer["DescriptionEnglishPlaceholder"]" class="form-control" required></textarea>
								<span asp-validation-for="DescriptionEn" class="text-danger"></span>
							</div>
						</div>
						<div class="col-md-6">
							<div class="subscription-form-group">
								<label asp-for="DescriptionAr">@Localizer["DescriptionArabic"] *</label>
								<textarea asp-for="DescriptionAr" placeholder="وصف ما تتضمنه هذه الخطة..." class="form-control" required></textarea>
								<span asp-validation-for="DescriptionAr" class="text-danger"></span>
							</div>
						</div>
					</div>

					<div class="row">
						<div class="col-md-6">
							<div class="subscription-form-group">
								<label asp-for="Price">@Localizer["PriceWithSymbol"] *</label>
								<input asp-for="Price" type="number" step="0.01" placeholder="0.00" class="form-control" required />
								<span asp-validation-for="Price" class="text-danger"></span>
							</div>
						</div>
						<div class="col-md-6">
							<div class="subscription-form-group">
								<label asp-for="DurationMonths">@Localizer["DurationMonths"] *</label>
								<input asp-for="DurationMonths" type="number" placeholder="@Localizer["DurationPlaceholder"]" class="form-control" required />
								<span asp-validation-for="DurationMonths" class="text-danger"></span>
							</div>
						</div>
					</div>

					<div class="row">
						<div class="col-md-6">
							<div class="subscription-form-group">
								<label asp-for="SessionLimit">@Localizer["SessionLimit"] *</label>
								<input asp-for="SessionLimit" type="number" placeholder="@Localizer["SessionLimitPlaceholder"]" class="form-control" required />
								<span asp-validation-for="SessionLimit" class="text-danger"></span>
							</div>
						</div>
						<div class="col-md-6">
							<div class="subscription-form-group">
								<label asp-for="IsActive">@Localizer["Active"]</label>
								<div style="margin-top: 0.5rem;">
									<label class="status-toggle-label" for="isActiveCheckbox">
										<input asp-for="IsActive" type="checkbox" class="form-check-input visually-hidden" id="isActiveCheckbox" />
										<div class="status-toggle-pill">
											<span class="pill-inactive">@Localizer["Inactive"]</span>
											<span class="pill-thumb"></span>
											<span class="pill-active">@Localizer["Active"]</span>
										</div>
									</label>
								</div>
							</div>
						</div>
					</div>

					<div style="display: flex; gap: 1rem; margin-top: 2rem;">
						<button type="submit" class="btn btn-subscription-primary d-inline-flex align-items-center justify-content-center gap-1" style="flex: 1;">
							<i data-lucide="check" style="width: 18px; height: 18px;"></i> @Localizer["UpdatePlan"]
						</button>
						<a href="@Url.Action("Index", "SubscriptionPlans")" class="btn btn-subscription-secondary d-inline-flex align-items-center justify-content-center gap-1" style="flex: 1; text-decoration: none;">
							<i data-lucide="x" style="width: 18px; height: 18px;"></i> @Localizer["Cancel"]
						</a>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}
