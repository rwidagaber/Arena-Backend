@model ArenaApplication.Dtos.SubscriptionPlanDtos.CreateSubscriptionPlanDto

@{
	ViewData["Title"] = "Create Subscription Plan";
}

<link rel="stylesheet" href="~/css/subscription-admin.css" />

<div class="subscription-admin-container">
	<div class="subscription-admin-header">
		<h1>➕ Create New Subscription Plan</h1>
		<p>Add a new subscription plan to your fitness platform</p>
	</div>

	<div class="container-fluid mt-4">
		<div class="row">
			<div class="col-lg-8 offset-lg-2">
				@if (!ViewData.ModelState.IsValid)
				{
					<div class="subscription-alert error">
						<strong>Please fix the following errors:</strong>
						<ul style="margin-top: 0.5rem; margin-bottom: 0;">
							@foreach (var modelState in ViewData.ModelState.Values)
							{
								@foreach (var error in modelState.Errors)
								{
									<li>@error.ErrorMessage</li>
								}
							}
						</ul>
					</div>
				}

				<form asp-action="Create" method="post" class="subscription-form">
					<div class="row">
						<div class="col-md-6">
							<div class="subscription-form-group">
								<label asp-for="NameEn">Plan Name (English) *</label>
								<input asp-for="NameEn" type="text" placeholder="e.g., Premium Plus" class="form-control" required />
								<span asp-validation-for="NameEn" class="text-danger"></span>
							</div>
						</div>
						<div class="col-md-6">
							<div class="subscription-form-group">
								<label asp-for="NameAr">Plan Name (Arabic) *</label>
								<input asp-for="NameAr" type="text" placeholder="مثال: بريميوم بلس" class="form-control" required />
								<span asp-validation-for="NameAr" class="text-danger"></span>
							</div>
						</div>
					</div>

					<div class="row">
						<div class="col-md-6">
							<div class="subscription-form-group">
								<label asp-for="DescriptionEn">Description (English) *</label>
								<textarea asp-for="DescriptionEn" placeholder="Describe what's included in this plan..." class="form-control" required></textarea>
								<span asp-validation-for="DescriptionEn" class="text-danger"></span>
							</div>
						</div>
						<div class="col-md-6">
							<div class="subscription-form-group">
								<label asp-for="DescriptionAr">Description (Arabic) *</label>
								<textarea asp-for="DescriptionAr" placeholder="وصف ما تتضمنه هذه الخطة..." class="form-control" required></textarea>
								<span asp-validation-for="DescriptionAr" class="text-danger"></span>
							</div>
						</div>
					</div>

					<div class="row">
						<div class="col-md-6">
							<div class="subscription-form-group">
								<label asp-for="Price">Price ($) *</label>
								<input asp-for="Price" type="number" step="0.01" placeholder="0.00" class="form-control" required />
								<span asp-validation-for="Price" class="text-danger"></span>
							</div>
						</div>
						<div class="col-md-6">
							<div class="subscription-form-group">
								<label asp-for="DurationMonths">Duration (Months) *</label>
								<input asp-for="DurationMonths" type="number" placeholder="e.g., 12" class="form-control" required />
								<span asp-validation-for="DurationMonths" class="text-danger"></span>
							</div>
						</div>
					</div>

					<div class="row">
						<div class="col-md-6">
							<div class="subscription-form-group">
								<label asp-for="SessionLimit">Session Limit *</label>
								<input asp-for="SessionLimit" type="number" placeholder="e.g., 50" class="form-control" required />
								<span asp-validation-for="SessionLimit" class="text-danger"></span>
							</div>
						</div>
					</div>

					<div style="display: flex; gap: 1rem; margin-top: 2rem;">
						<button type="submit" class="btn btn-subscription-primary" style="flex: 1;">
							✅ Create Plan
						</button>
						<a href="@Url.Action("Index", "SubscriptionPlans")" class="btn btn-subscription-secondary" style="flex: 1; text-decoration: none; display: flex; align-items: center; justify-content: center;">
							❌ Cancel
						</a>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}
