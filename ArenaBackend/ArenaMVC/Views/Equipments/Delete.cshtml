@model ArenaApplication.Dtos.Gym.EquipmentDto
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["DeleteEquipment"]?.Value ?? "Delete Equipment";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 border-danger border-top border-3 bg-surface">
                <div class="card-header bg-transparent border-bottom pt-4 pb-3 px-4 text-center">
                    <div class="mb-3">
                        <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-10 rounded-circle" style="width: 64px; height: 64px;">
                            <i data-lucide="alert-triangle" class="text-danger" style="width: 32px; height: 32px;"></i>
                        </div>
                    </div>
                    <h3 class="mb-1 text-foreground">@ViewData["Title"]</h3>
                    <p class="text-muted mb-0">@(Localizer["AreYouSureYouWantToDeleteThis"]?.Value ?? "Are you sure you want to delete this equipment? This action cannot be undone.")</p>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted fw-medium">
                            @Html.DisplayNameFor(model => model.Name)
                        </dt>
                        <dd class="col-sm-8 text-foreground fw-medium">
                            @if (System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrEmpty(Model.NameAr))
                            {
                                <span dir="rtl">@Model.NameAr</span>
                            }
                            else
                            {
                                @Model.Name
                            }
                        </dd>
                        
                        <dt class="col-sm-4 text-muted fw-medium mt-2">
                            @Html.DisplayNameFor(model => model.Category)
                        </dt>
                        <dd class="col-sm-8 mt-2">
                            <span class="badge bg-secondary">@Html.DisplayFor(model => model.Category)</span>
                        </dd>
                        
                        <dt class="col-sm-4 text-muted fw-medium mt-2">
                            @Html.DisplayNameFor(model => model.IsAvailable)
                        </dt>
                        <dd class="col-sm-8 mt-2">
                            @if (Model.IsAvailable)
                            {
                                <span class="badge bg-success">@(Localizer["Yes"]?.Value ?? "Yes")</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">@(Localizer["No"]?.Value ?? "No")</span>
                            }
                        </dd>
                    </dl>
                </div>
                <div class="card-footer bg-transparent border-top p-4">
                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-2 justify-content-center">
                            <a asp-action="Index" class="btn btn-light d-flex align-items-center gap-2">
                                <i data-lucide="arrow-left" class="icon-sm"></i>
                                @(Localizer["Cancel"]?.Value ?? "Cancel")
                            </a>
                            <button type="submit" class="btn btn-danger d-flex align-items-center gap-2">
                                <i data-lucide="trash-2" class="icon-sm"></i>
                                @(Localizer["ConfirmDelete"]?.Value ?? "Confirm Delete")
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
