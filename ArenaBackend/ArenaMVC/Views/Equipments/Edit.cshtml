@model ArenaApplication.Dtos.Gym.EquipmentDto
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["EditEquipment"]?.Value ?? "Edit Equipment";
}

<link rel="stylesheet" href="~/css/subscription-admin.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/user-admin.css" asp-append-version="true" />

<div class="subscription-admin-container">
    <div class="subscription-admin-header d-flex flex-wrap align-items-start justify-content-between gap-3">
        <div>
            <h1><i data-lucide="edit" style="width: 32px; height: 32px; vertical-align: middle; margin-inline-end: 8px;"></i>@ViewData["Title"]</h1>
            <p>@(Localizer["UpdateEquipmentDetails"]?.Value ?? "Modify the details of the selected equipment.")</p>
        </div>
        <div class="booking-header-actions">
            <a class="btn btn-subscription-secondary d-inline-flex align-items-center gap-1" asp-controller="Equipments" asp-action="Index">
                <i data-lucide="arrow-left" style="width: 14px; height: 14px;"></i>@(Localizer["BackToList"]?.Value ?? "Back to List")
            </a>
        </div>
    </div>

    <div class="container-fluid mt-4">
        @if (TempData["Error"] != null)
        {
            <div class="subscription-alert error">
                <strong>@Localizer["Error"]</strong> @TempData["Error"]
            </div>
        }

        <div class="row justify-content-center" style="padding-top: 2rem; padding-bottom: 4rem;">
            <div class="col-lg-6 col-md-8">
                <div class="manage-user-card" style="background-color: var(--card-bg); padding: 2rem; border-radius: 12px; border: 1px solid var(--border-color); box-shadow: var(--card-shadow);">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="subscription-form-group mb-4">
                            <label asp-for="Name" style="color: var(--yellow); font-weight: 600; margin-bottom: 0.5rem; display: block;">
                                @Html.DisplayNameFor(m => m.Name) <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Name" class="form-control" style="background-color: var(--body-bg); border-color: var(--border-color); color: var(--foreground);" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="subscription-form-group mb-4">
                            <label asp-for="Category" style="color: var(--yellow); font-weight: 600; margin-bottom: 0.5rem; display: block;">
                                @Html.DisplayNameFor(m => m.Category) <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Category" class="form-control" style="background-color: var(--body-bg); border-color: var(--border-color); color: var(--foreground);" />
                            <span asp-validation-for="Category" class="text-danger small"></span>
                        </div>

                        <div class="subscription-form-group mb-4">
                            <label style="color: var(--yellow); font-weight: 600; margin-bottom: 0.5rem; display: block;">
                                @Html.DisplayNameFor(m => m.IsAvailable)
                            </label>
                            <div class="switch-container d-flex align-items-center gap-3">
                                <span class="switch-label-text">
                                    <span id="statusLabelText" class="slider-status-text @(Model?.IsAvailable ?? true ? "active" : "inactive")" style="color: @(Model?.IsAvailable ?? true ? "#10b981" : "#ef4444"); font-weight: 600;">
                                        @(Model?.IsAvailable ?? true ? Localizer["Available"]?.Value ?? "Available" : Localizer["Unavailable"]?.Value ?? "Unavailable")
                                    </span>
                                </span>
                                <label class="switch" for="isAvailableToggle" style="position: relative; display: inline-block; width: 50px; height: 26px;">
                                    <input type="checkbox" asp-for="IsAvailable" id="isAvailableToggle" style="opacity: 0; width: 0; height: 0;" />
                                    <span class="slider" style="position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #4b5563; transition: .4s; border-radius: 34px;"></span>
                                </label>
                            </div>
                        </div>

                        <div class="d-flex gap-3 mt-4 pt-4 border-top" style="border-color: var(--border-color) !important;">
                            <button type="submit" class="btn btn-subscription-primary" style="flex: 1; padding: 0.75rem 1.5rem; font-weight: 600;">@(Localizer["SaveChanges"]?.Value ?? "Save Changes")</button>
                            <a asp-action="Index" class="btn btn-ghost" style="flex: 1;">@(Localizer["Cancel"]?.Value ?? "Cancel")</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <style>
        .switch input:checked + .slider { background-color: #10b981; }
        .switch input:focus + .slider { box-shadow: 0 0 1px #10b981; }
        .switch input:checked + .slider:before { transform: translateX(24px); }
        .switch .slider:before {
            position: absolute; content: ""; height: 20px; width: 20px; left: 3px; bottom: 3px; background-color: white; transition: .4s; border-radius: 50%;
        }
    </style>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const toggle = document.getElementById('isAvailableToggle');
            const statusLabel = document.getElementById('statusLabelText');
            if (toggle && statusLabel) {
                toggle.addEventListener('change', function () {
                    if (this.checked) {
                        statusLabel.textContent = '@(Localizer["Available"]?.Value ?? "Available")';
                        statusLabel.style.color = '#10b981';
                    } else {
                        statusLabel.textContent = '@(Localizer["Unavailable"]?.Value ?? "Unavailable")';
                        statusLabel.style.color = '#ef4444';
                    }
                });
            }
        });
    </script>
}
