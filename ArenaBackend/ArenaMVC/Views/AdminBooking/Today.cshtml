@using ArenaDomain.Enums
@model List<ArenaApplication.Dtos.Booking.BookingDto>

@{
    ViewData["Title"] = "Today's Bookings";
}

<link rel="stylesheet" href="~/css/subscription-admin.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/booking-admin.css" asp-append-version="true" />

<div class="booking-admin-container">
    <div class="subscription-admin-header d-flex flex-wrap align-items-start justify-content-between gap-3">
        <div>
            <h1>📆 Today's Bookings</h1>
            <p>Bookings scheduled for today (UTC).</p>
        </div>
        <div class="booking-header-actions">
            <a class="btn btn-subscription-secondary" asp-controller="AdminBooking" asp-action="Index">Back to Bookings</a>
        </div>
    </div>

    <div class="booking-table-wrap">
        <div class="table-responsive">
            <table class="booking-table">
                <thead>
                    <tr>
                        <th style="width: 16%;">Date</th>
                        <th style="width: 12%;">Start</th>
                        <th style="width: 12%;">End</th>
                        <th style="width: 22%;">Member profile</th>
                        <th style="width: 14%;">Status</th>
                        <th style="width: 24%;">Booking ID</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model is null || Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-empty">
                                No bookings scheduled for today.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var b in Model.OrderBy(x => x.StartTime))
                        {
                            var badgeClass = b.Status == BookingStatus.Confirmed
                                ? "booking-badge booking-badge-confirmed"
                                : b.Status == BookingStatus.Cancelled
                                    ? "booking-badge booking-badge-cancelled"
                                    : "booking-badge booking-badge-other";

                            <tr>
                                <td>@b.BookingDate.ToString("yyyy-MM-dd")</td>
                                <td>@b.StartTime.ToString(@"hh\:mm")</td>
                                <td>@(b.EndTime.HasValue ? b.EndTime.Value.ToString(@"hh\:mm") : "-")</td>
                                <td><span class="mono-id">@b.MemberProfileId</span></td>
                                <td><span class="@badgeClass">@b.Status</span></td>
                                <td><span class="mono-id">@b.Id</span></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
